{
  "name": "digital-service-pack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:link": "npx supabase link",
    "smoke:accounts": "npx supabase db query --local -f supabase/verify-smoke-data.sql -o table",
    "db:status": "npx supabase status",
    "types:supabase": "supabase gen types typescript --local --schema public > lib/types/database.generated.ts",
    "verify:stripe": "node scripts/verify-stripe.cjs",
    "verify:stripe-webhooks": "node scripts/verify-stripe-webhooks.cjs",
    "verify:launch": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify:app-store": "node scripts/verify-app-store-readiness.cjs",
    "verify:launch-env": "node scripts/verify-launch-env.cjs",
    "verify": "npm run verify:launch-env && npm run verify:stripe && npm run verify:stripe-webhooks && npm run verify:app-store",
    "cap:sync": "npx cap sync ios",
    "cap:sync:prod": "npx cap sync ios",
    "cap:copy": "npx cap copy ios",
    "cap:open:ios": "npx cap open ios",
    "cap:ios": "npm run cap:sync && npm run cap:open:ios"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/share": "^8.0.1",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "archiver": "^7.0.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "supabase": "^2.98.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
